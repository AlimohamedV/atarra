# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg

# Environment / secrets
.env
.env.local
.env.*.local
web/.env.local
web/.env.*.local

# Data. The whole point of the /vsicurl design is that we do NOT keep imagery on
# disk; only small derived products live here. Never commit it.
data/
!data/.gitkeep

# Model artefacts. Training writes checkpoints and exports, both of which are
# large binaries that are reproducible from the code and the cached tiles.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.pkl

# Raster / array outputs from ad-hoc runs. Never source.
*.tif
*.tiff
*.npy
*.npz

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
# Generated by Next.js on every build.
web/next-env.d.ts

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent tool state.
.freebuff/
