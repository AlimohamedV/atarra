# Copy to `.env` and adjust. Every setting is optional; defaults target the
# credential-free AWS/STAC path.

# Where derived products (tiles, previews, checkpoints) are written.
# Keep this small: the pipeline reads imagery over the network via /vsicurl
# rather than downloading GeoTIFFs, so the cache stays modest by design.
ATARRA_DATA_DIR=./data

# --- Primary imagery source (no auth, no cost) ---
ATARRA_STAC_URL=https://earth-search.aws.element84.com/v1
ATARRA_STAC_COLLECTION=sentinel-2-l2a

# --- Quality gates ---
# Scenes above this cloud percentage are rejected.
ATARRA_MAX_CLOUD_COVER=10

# --- Target raster grid ---
ATARRA_TILE_SIZE=256
ATARRA_TARGET_GSD=10

# --- Storage guard rail ---
# Hard ceiling for the on-disk tile cache in GB. The cache evicts LRU when the
# ceiling is exceeded so a runaway loop cannot fill the drive.
ATARRA_MAX_CACHE_GB=2

# --- Secondary imagery source (optional, ESA CDSE OAuth) ---
# Only needed if you want CDSE provenance. Leave blank to use STAC only.
ATARRA_CDSE_USERNAME=
ATARRA_CDSE_PASSWORD=
